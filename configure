#!/bin/sh

set -eu

CC=${CC:-cc}
CFLAGS=${CFLAGS:-"-std=c99 -Wall -Wextra -Wpedantic -O2"}
CPPFLAGS=${CPPFLAGS:-}
LDFLAGS=${LDFLAGS:-}
PKG_CONFIG=${PKG_CONFIG:-pkg-config}
NCURSES_CFLAGS=${NCURSES_CFLAGS:-}
NCURSES_LIBS=${NCURSES_LIBS:-}

escape_sed() {
    printf '%s' "$1" | sed 's/[\/&]/\\&/g'
}

is_gnu_make() {
    make_cmd="$1"
    if ! command -v "$make_cmd" >/dev/null 2>&1; then
        return 1
    fi
    "$make_cmd" --version 2>/dev/null | grep -q "GNU Make"
}

check_curses_link() {
    cflags="$1"
    libs="$2"

    cat > conftest.c <<'EOF'
#include <ncurses.h>
int main(void) {
    initscr();
    endwin();
    return 0;
}
EOF

    if "$CC" $CFLAGS $CPPFLAGS $cflags conftest.c $LDFLAGS $libs -o conftest >/dev/null 2>&1; then
        rm -f conftest.c conftest
        return 0
    fi

    rm -f conftest.c conftest
    return 1
}

MAKE_CMD=
if [ -n "${MAKE:-}" ] && is_gnu_make "$MAKE"; then
    MAKE_CMD=$MAKE
elif is_gnu_make make; then
    MAKE_CMD=make
elif is_gnu_make gmake; then
    MAKE_CMD=gmake
else
    echo "configure: error: GNU make is required to build this project." >&2
    echo "configure: hint: install gmake (GNU make) and rerun ./configure." >&2
    exit 1
fi

if [ -z "$NCURSES_LIBS" ] && command -v "$PKG_CONFIG" >/dev/null 2>&1; then
    for pkg in ncursesw ncurses curses; do
        if "$PKG_CONFIG" --exists "$pkg" >/dev/null 2>&1; then
            NCURSES_CFLAGS=$("$PKG_CONFIG" --cflags "$pkg")
            NCURSES_LIBS=$("$PKG_CONFIG" --libs "$pkg")
            break
        fi
    done
fi

if [ -z "$NCURSES_LIBS" ]; then
    for cflags_try in "" "-I/usr/local/include" "-I/usr/local/include/ncurses"; do
        for libs_try in "-lncursesw -ltinfo" "-lncursesw" "-lncurses -ltinfo" "-lncurses" "-lcurses"; do
            if check_curses_link "$cflags_try" "$libs_try"; then
                NCURSES_CFLAGS=$cflags_try
                NCURSES_LIBS=$libs_try
                break 2
            fi
        done
    done
fi

if [ -z "$NCURSES_LIBS" ]; then
    echo "configure: error: could not find a working curses configuration." >&2
    echo "configure: hint: set NCURSES_CFLAGS/NCURSES_LIBS explicitly." >&2
    exit 1
fi

sed \
    -e "s/@CC@/$(escape_sed "$CC")/" \
    -e "s/@CFLAGS@/$(escape_sed "$CFLAGS")/" \
    -e "s/@CPPFLAGS@/$(escape_sed "$CPPFLAGS")/" \
    -e "s/@LDFLAGS@/$(escape_sed "$LDFLAGS")/" \
    -e "s/@NCURSES_CFLAGS@/$(escape_sed "$NCURSES_CFLAGS")/" \
    -e "s/@NCURSES_LIBS@/$(escape_sed "$NCURSES_LIBS")/" \
    Makefile.in > GNUmakefile

cat > Makefile <<EOF
# Auto-generated by ./configure. Delegates to GNU make.
GNUMAKE = $MAKE_CMD

all spacetrader clean install uninstall:
	\$(GNUMAKE) -f GNUmakefile \$@ \
		CC="\$(CC)" CFLAGS="\$(CFLAGS)" CPPFLAGS="\$(CPPFLAGS)" LDFLAGS="\$(LDFLAGS)" \
		NCURSES_CFLAGS="\$(NCURSES_CFLAGS)" NCURSES_LIBS="\$(NCURSES_LIBS)" \
		DESTDIR="\$(DESTDIR)" BINDIR="\$(BINDIR)" MAN6DIR="\$(MAN6DIR)" \
		INSTALL="\$(INSTALL)" RM="\$(RM)"

.PHONY: all spacetrader clean install uninstall
EOF

echo "Configuration complete."
echo "  MAKE=$MAKE_CMD"
echo "  CC=$CC"
echo "  CFLAGS=$CFLAGS"
echo "  CPPFLAGS=$CPPFLAGS"
echo "  LDFLAGS=$LDFLAGS"
echo "  NCURSES_CFLAGS=$NCURSES_CFLAGS"
echo "  NCURSES_LIBS=$NCURSES_LIBS"
echo
echo "Now run: make"
